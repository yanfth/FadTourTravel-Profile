+/* Glassmorphism Utilities */
+.glass-light-card {
+  background: rgba(255, 255, 255, 0.92);
+  backdrop-filter: blur(18px);
+  -webkit-backdrop-filter: blur(18px);
+  border: 1px solid rgba(255, 255, 255, 0.85);
+  box-shadow: 0 24px 48px -14px rgba(7, 13, 29, 0.28);
+}
+
+.glass-frosted-dark {
+  background: rgba(255, 255, 255, 0.12);
+  backdrop-filter: blur(20px);
+  -webkit-backdrop-filter: blur(20px);
+  border: 1px solid rgba(255, 255, 255, 0.22);
+  box-shadow: 0 25px 50px -12px rgba(5, 10, 22, 0.5);
+}
+
+/* Atmospheric Photo Vignette in Panoramic Sky */
+.zone-photo-vignette {
+  -webkit-mask-image: radial-gradient(ellipse 75% 58% at 50% 58%, rgba(0,0,0,0.42) 0%, rgba(0,0,0,0.16) 55%, transparent 82%);
+  mask-image: radial-gradient(ellipse 75% 58% at 50% 58%, rgba(0,0,0,0.42) 0%, rgba(0,0,0,0.16) 55%, transparent 82%);
+}
+
+/* Active Stop Pin Pulse */
+@keyframes pinPulseRing {
+  0% {
+    transform: scale(1);
+    opacity: 0.85;
+  }
+  100% {
+    transform: scale(2.05);
+    opacity: 0;
+  }
+}
+.pin-pulse-ring {
+  transform-box: fill-box;
+  transform-origin: center;
+  animation: pinPulseRing 2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
+}
+
+/* Package Card Lift */
+.tour-pkg-card {
+  transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
+}
+.tour-pkg-card:hover {
+  transform: translateY(-5px);
+  box-shadow: 0 26px 52px -18px rgba(15, 23, 42, 0.16);
 }
