+
+    const s1 = stops[seg];
+    const s2 = stops[Math.min(N - 1, seg + 1)];
+    if (s1 && s2 && skyLayerRef.current) {
+      const cTop = lerpColor(s1.skyTop, s2.skyTop, localT);
+      const cMid = lerpColor(s1.skyMid, s2.skyMid, localT);
