+    renderPins(stopLengthsRef.current, activeIdx, stops);
+  }, [getFilteredStops, activeIdx, renderPins]);
+
+  // Setup ScrollTrigger with PIN: TRUE (Section remains locked on screen while horizontal route pans)
+  useEffect(() => {
